# TypeScript incremental build cache
*.tsbuildinfo

# Safety net: tsconfig.node.json sends its emit to node_modules/.tmp, so these
# should never appear here. If they do, do not commit them — Vite resolves
# vite.config.js *before* vite.config.ts and a stale copy silently shadows
# the real config.
vite.config.js
vite.config.d.ts

# vite-plugin-pwa development output
dev-dist/
